# ================================
# ✅ GLOBAL FRONTEND MONOREPO IGNORE
# For: landing/ and admin/ projects
# ================================

# ----------------
# Dependencies
# ----------------
node_modules/
**/node_modules/

# Yarn / PnP
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----------------
# Build outputs
# ----------------
.next/
out/
build/
dist/
dist-ssr/
**/.next/
**/out/
**/build/
**/dist/
**/dist-ssr/

# ----------------
# Environment files
# ----------------
.env
.env.*
**/.env
**/.env.*
.env.local

# ----------------
# Testing & Coverage
# ----------------
coverage/
**/coverage/

# ----------------
# Logs & Debug files
# ----------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ----------------
# Misc / System files
# ----------------
.DS_Store
*.pem
*.local

# ----------------
# Editor configs
# ----------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----------------
# TypeScript build info
# ----------------
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# ----------------
# Hosting / Deployment
# ----------------
.vercel/
**/.vercel/

# ================================
# END
# ================================
